# Web interface password. Leave this blank and the server generates one on
# first run and prints it, which is the easiest way to get started. Change it
# to whatever you like and restart; doing so logs out every device.
UNIAGENT_PASSWORD=

# API Keys — add your own values here
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Email accounts, as one JSON list. Each needs a name (what a tool call passes
# as "account"), an address and a password - an app password where the provider
# wants one. The servers are worked out from the address, so nothing else is
# usually needed; add "imap"/"smtp" (and "imap_port"/"smtp_port"/
# "smtp_security"/"tls_verify") only for a provider that needs something
# unusual. "default": true marks the account used when a call doesn't name one.
# The settings page writes this line for you and tests the sign-in.
EMAIL_ACCOUNTS=[{"name":"personal","address":"you@example.com","password":"app password","default":true}]
