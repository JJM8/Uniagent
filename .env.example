# Uniagent configuration. Copy to .env and fill in what you need.
#
# Every value must be on ONE line - the file is read line by line, so a JSON
# value that wraps is a JSON value that breaks. Nothing here is loaded into the
# process environment at startup; each part of Uniagent reads the file when it
# needs it, so a change is live on the next message with nothing to restart.
#
# The settings page writes most of this for you: providers on the providers tab,
# mail accounts on the email tab. Editing by hand is the fallback, not the path.


# --- The web interface -------------------------------------------------------

# Password for the web UI. Leave it blank and the server generates one on first
# run and prints it to the terminal - the easiest way to start. No surrounding
# quotes: they are stripped when the file is read, so a quoted password saves as
# one thing and is checked as another, and you cannot log in.
UNIAGENT_PASSWORD=

# Which ports the web interface listens on. Both are optional - left blank they
# are 8763 and 8764. UNIAGENT_HTTPS_PORT is the one you actually browse to; the
# plain one serves nothing but a redirect up to it. Change them if something
# else on the machine already has those numbers. A value that isn't a port
# (1-65535) is ignored and the default used, so a typo here cannot stop the
# server starting. Changing either takes a restart, since it means rebinding
# the socket.
UNIAGENT_PORT=
UNIAGENT_HTTPS_PORT=


# --- Model providers ---------------------------------------------------------

# THE model configuration. One JSON list, one object per provider, and there is
# no built-in list behind it: an empty LLM_PROVIDERS means no models at all.
#
#   name      required. Lowercase slug. What you pick on the models tab, what
#             /model takes, what a cron job or subagent points at.
#   wire      required. The protocol the endpoint speaks, NOT the company:
#             openai, deepseek, anthropic, gemini, local, bedrock,
#             claude-subscription. Nearly every third-party endpoint serves
#             OpenAI's /chat/completions, so "openai" is the answer unless you
#             know otherwise. Use "deepseek" for DeepSeek itself - it adds the
#             two things DeepSeek's own thinking models need.
#   key       the API key. Ignored by bedrock (signs with your AWS credentials)
#             and claude-subscription (drives the Claude Code CLI's own login).
#   base_url  optional. Empty means the wire's own host. For bedrock this box
#             is the AWS region instead.
#   id        optional - generated and written back if absent. A provider's
#             permanent identity, so renaming one keeps its learned models.
#   icon      optional path to a picture. Empty follows the wire.
#   config    optional answers to the wire's setup form, e.g.
#             {"AWS_REGION":"eu-west-2"}. Falls back to the real environment.
#   models    optional manual model list, for an endpoint with no catalogue.
#
# The same company can appear as many times as you like - a work key and a
# personal key are simply two providers.
#
# Left EMPTY on purpose. This file is copied straight to .env by the installer,
# so anything filled in here is a provider every new install believes it already
# has - the setup wizard would report "already configured: deepseek, local" and
# skip the question, and the models tab would offer a provider whose key is the
# literal string "your-deepseek-key". An example belongs in a comment, not in
# the value. The wizard writes this line for you; so does the settings page.
#
#   LLM_PROVIDERS=[{"name":"deepseek","wire":"deepseek","key":"sk-..."},{"name":"lmstudio","wire":"local","base_url":"http://localhost:1234/v1","key":""}]
LLM_PROVIDERS=


# --- Email -------------------------------------------------------------------

# Every mailbox the agent can read and send from, as one JSON list. Each needs a
# name (what a tool call passes as "account"), an address and a password - an app
# password where the provider insists on one, which most now do. The servers are
# worked out from the address, so imap/smtp are only needed for a provider that
# needs something unusual; imap_port, smtp_port, smtp_security and tls_verify
# are there for the same reason. "default": true marks the account a call gets
# when it names none.
#
# The email tab writes this line for you and tests the sign-in, which retyping
# one long line of JSON does not.
#
# Empty on purpose, for the same reason as LLM_PROVIDERS above: this file is
# copied straight to .env, so a filled-in line here is a mailbox every new
# install thinks it has. The agent would list "personal" as available and every
# send would fail against you@example.com.
#
#   EMAIL_ACCOUNTS=[{"name":"personal","address":"you@example.com","password":"app password","default":true}]
EMAIL_ACCOUNTS=


# --- Optional, read from the real environment as well as this file -----------

# Where a "local" wire points when a provider names no base URL of its own.
# LMSTUDIO_URL=http://localhost:1234/v1

# Bedrock's region, if you are not setting it per-provider and have no ~/.aws.
# AWS_REGION=eu-west-2

# --- Workspaces -------------------------------------------------------------
# Where the file tools and the terminal do their work, and on which machine.
# One JSON list, exactly like LLM_PROVIDERS and EMAIL_ACCOUNTS above, and
# normally written by the settings page's workspaces tab rather than by hand.
#
# Each chat keeps the ID of the workspace it is in, in its own settings.json,
# so two conversations can be working in two different places at once. A chat
# with none set uses the one marked "default". With no workspaces at all,
# everything happens in the Uniagent folder itself, exactly as it did before
# this existed - so leaving this empty changes nothing.
#
#   id       what chats point at. Fixed once created, so renaming is safe.
#   name     what it is called in the dropdown and in tool output.
#   path     the root a relative path is resolved against.
#   ssh      empty for this machine, or "user@host", or a Host alias from
#            ~/.ssh/config. Anything else means the file tools and the terminal
#            genuinely run over there.
#   port     optional ssh port, when it is not 22.
#   default  which one a chat gets when it has never been given one.
#
# A REMOTE WORKSPACE NEEDS KEY-BASED SSH. Connections are made with
# BatchMode=yes and never prompt: a password prompt inside a background service
# is a question nobody can see or answer, and the turn would hang forever.
# Run `ssh-copy-id you@machine` once from the machine Uniagent runs on.
#
#   WORKSPACES=[{"id":"projects","name":"Projects","path":"/home/you/projects","ssh":"","default":true},{"id":"pi","name":"Pi","path":"/home/you","ssh":"you@192.168.1.50"}]
WORKSPACES=
