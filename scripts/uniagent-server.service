[Unit]
Description=Uniagent web server - the chat UI on http://localhost:8763
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Unbuffered, so the agent's output reaches the journal live instead of sitting
# in a block buffer until the process exits.
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/path/to/Documents/projects/Uniagent/scripts
ExecStart=/usr/bin/python3 /path/to/Documents/projects/Uniagent/scripts/server.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
