#!/bin/sh
# The `uniagentcli` command. Symlinked into ~/.local/bin, so this file stays in
# the repo and the link follows it - readlink -f resolves the symlink back to
# this script's real home, which is how cli.py is found no matter where the
# repo lives or which directory the command was run from.
DIR=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
exec python3 "$DIR/cli.py" "$@"
