# Secrets - never commit these
.env

# The https listener's self-signed certificate and its private key - made on
# this machine, for this machine's own addresses (see server.py). No other
# machine can use them, and the key is a secret.
certs/

__pycache__/
*.pyc

# Python virtualenv - created by install.ps1 on Windows (and handy on Linux)
.venv/

# The 'uniagentcli' shim copied here by install.ps1 - regenerated on install
bin/

# --- Anything that is about THIS install rather than about Uniagent ---------
# The rule: if a file fills up as you use the agent, or names your machine,
# your accounts or the people in your life, it stays here. Each one below that
# something else needs an example of ships as <name>.example.<ext> instead.

# Conversation transcripts - personal, and they'd be permanent in history
chats/

# What the agent has learned about its user. Both halves: the always-loaded
# facts file (context/2memory.md, which fills up with their accounts, their
# hardware, the people in their life) and the per-topic files. Anchored, like
# /context/ below, so it takes the live folder and not defaults/memories/.
/memories/

# The live context folder - the user's prompts, edited to taste, and the memory
# file above. What ships is defaults/context/, which main.seed_context() copies
# in when a file here is missing and the settings page's "revert to default"
# puts back wholesale. Keeping the live copy out means a pull can never land on
# top of an edited system prompt. Anchored with a leading slash: an unanchored
# "context/" would match at any depth and take defaults/context/ - the one copy
# that has to stay in the repo - down with it.
/context/

# Where "revert to default" puts the old context/ folder, dated. Same personal
# facts, just yesterday's.
/archive/

# Scheduled jobs - your prompts, your addresses, your routine. cron.example.json
# is the documented one; this is yours.
cron.json
# The watcher's per-job last-run bookkeeping
cron_state.json

# MCP servers - paths into your other projects, and the place an auth token
# would sit. mcp.example.json is the documented one.
mcp.json

# Live settings: which provider you chat on, your safety prompt, your accent
# colour. Rewritten every time you touch the settings page, and every default
# in it is in settings.py anyway.
settings.json

# Models proven to work on YOUR providers, keyed by your provider ids
models_custom.json
models_custom.json.backup

# Working directories the agent writes into
workspace/
websites/
documents/
# Tools and skills copied in by the sidebar's pin button - regenerated on use
pinned/
# Output of background terminal jobs - disposable, and can get large
background-terminal-output/

# Editor config - personal per-machine settings
.vscode/
.claude/

# The scratch Firefox profile the browser tools drive. THIS MUST NEVER BE
# COMMITTED: a Firefox profile holds logins.json and key4.db (saved passwords
# and the key that decrypts them), cookies.sqlite (live session tokens - anyone
# with the file is signed in as you) and places.sqlite (your whole browsing
# history). The rest of the folder is debug dumps from working on those tools.
firefox_bg/

# One-off experiments and their output - scratch, and the captures inside are
# whatever page happened to be open at the time.
experiments/

# The updater's crash note - the tools and skills it has moved out of the way
# mid-update, so the next run can put them back. Only exists while one is
# running, and it is about THIS install's switched-off bundles. See update.py.
update_state.json

# Logs.
*.log
nohup.out
scripts/nohup.out

# Scratch and third-party material that was never Uniagent's to publish
unused/claude skills/
unused/context copy/
unused/skills/
unused/memory.md

# Personal notes
TODO.md
august-uniagent-todo.md

# Side projects and agent output that happen to live in this folder but are not
# Uniagent. The images are scraped off the web - someone else's copyright, not
# ours to republish.
stickfight/
sky-strike.html
images/*/
!images/screenshots/
scripts/esp32-upload.json
scripts/esp32-upload.json.eeda.json
# Which file the edagent CLI last had open - per-machine state
scripts/.edagent

# Dead code and old drafts kept around locally - not part of the project
unused/
